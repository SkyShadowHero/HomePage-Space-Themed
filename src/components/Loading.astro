<script is:inline>
// 脚印加载动画：最少展示 1 秒，最多等待 6 秒（资源挂起也强制隐藏）
window.addEventListener('DOMContentLoaded', function() {
  const fps = document.querySelectorAll('#footprints .footprint');
  let step = 0;
  function animateFootprints() {
    fps.forEach((fp, i) => {
      fp.style.opacity = (i === step) ? '1' : '0.2';
    });
    step = (step + 1) % 3;
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let timer = null;
  if (reduceMotion) {
    fps.forEach(fp => { fp.style.opacity = '1'; });
  } else {
    timer = setInterval(animateFootprints, 350);
    animateFootprints();
  }

  let minShow = false, loaded = false, hidden = false;
  function hideLoadingMask() {
    if (hidden) return;
    hidden = true;
    if (timer) clearInterval(timer);
    const mask = document.getElementById('loading-mask');
    if (mask) {
      mask.style.opacity = '0';
      setTimeout(() => {
        mask.style.display = 'none';
      }, 500);
    }
  }

  // 最少展示 1 秒
  setTimeout(() => {
    minShow = true;
    if (loaded) hideLoadingMask();
  }, 1000);
  // 最多等待 6 秒：即使 window.load 迟迟不来也强制隐藏
  setTimeout(hideLoadingMask, 6000);

  window.addEventListener('load', function() {
    loaded = true;
    if (minShow) hideLoadingMask();
  });
});
</script>
